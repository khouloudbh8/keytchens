###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/mongodb-odm-bundle ###
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB="keytchens"
###< doctrine/mongodb-odm-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1|vitrine\.test)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

